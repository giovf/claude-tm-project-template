# ── Dependencies
node_modules/

# ── Build output (extend per stack during /setup)
dist/
build/
out/
*.tsbuildinfo

# ── Environment variables (never commit real secrets)
.env
.env*.local

# ── Dev container lockfile (pins feature versions; we want latest)
.devcontainer/devcontainer-lock.json

# ── Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# ── OS / editor
.DS_Store
.idea/
*.suo
*.sw?

# ── Taskmaster (generated/state files)
.taskmaster/reports/
.taskmaster/state.json

# ── Claude Code local files
.claude/.credentials.json
.claude/projects/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude.json

# ── Certificates & keys
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision
